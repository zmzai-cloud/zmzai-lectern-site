lectern.zmzai.cloud {
	root * /var/www/lectern
	encode gzip zstd

	# 部署备份/历史残留（*.bak*、*.backup*）曾被公开直达，这里兜底封死
	@stale path */.bak* */.backup* /*.bak* /*.backup*
	respond @stale "Not Found" 404

	# HTML 每次校验（发版即生效）；带 ?v= 的样式与脚本可长期钉死；图片 1 天
	@versioned path /theme.css /theme.js
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@media path *.png *.svg *.ico *.webp
	header @media Cache-Control "public, max-age=86400"
	@html path / /*.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header Strict-Transport-Security "max-age=15552000"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"

	file_server
}

harness.zmzai.cloud {
	redir https://lectern.zmzai.cloud{uri} 301
}

